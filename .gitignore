.vscode/*
!.vscode/extensions.json
# Agent-managed Git worktrees are local, disposable workspace state.
/.claude/worktrees/
node_modules/
.env
# install.sh --force backs the old env up as .env.bak.<ts>; never let those
# (with live secrets) reach git. (.env.example and frontend/.env stay tracked.)
.env.bak*
*.bak
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Frontend build artifact produced by scripts/build-frontend-dist.sh (injected
# into the frontend-dist volume on low-memory servers; ~6MB, never commit).
/frontend-dist.tar.gz

# Local frontend overrides (e.g. VITE_API_URL=http://localhost:8000 for the
# vite dev server). Keep release artifacts built same-origin (empty VITE_API_URL).
frontend/.env.local

# Local uploads (test artifacts)
backend/data/uploads/
