# Copy this file to .env and replace every placeholder before deployment.
DOMAIN=localhost
# Production: set to the public origin, e.g. https://notellm.au1bhi.com — this
# is where verification/password-reset emails point their links.
FRONTEND_HOST=http://localhost:5173
ENVIRONMENT=local
PROJECT_NAME=NoteLLM
STACK_NAME=notellm
# Full-viewport screenshot watermark (served by GET /meta/watermark).
WATERMARK_TEXT=notellm.au1bhi.com
# Set false to disable the watermark entirely.
WATERMARK_ENABLED=true
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173
# 国内服务器镜像加速（install.sh 会引导选择并校验连通性；也可手工填写）。
# REGISTRY_MIRROR 留空 = 直连 Docker Hub；否则为完整 Docker Hub 代理镜像
# 地址（末尾带 /），例如 docker.1ms.run/、docker.m.daocloud.io/。它用于给
# pgvector/pgvector、traefik/traefik 等非 library/ 命名空间镜像加前缀。
REGISTRY_MIRROR=
# pip / npm 镜像源（仅 REGISTRY_MIRROR 非空时默认填入国内镜像；留空 = 官方源）。
PYPI_INDEX_URL=
NPM_REGISTRY=

# Production (compose.traefik.yml):
#   EMAIL=<your email>            Let's Encrypt certificate expiry notifications
#   TAG=latest                    image tag when not building locally

# Low-memory frontend artifact. An explicit URL must include either the exact
# SHA-256 value or a URL returning a standard SHA-256 line. When unset, a local
# frontend-dist.tar.gz + .sha256 pair is used, otherwise an asset matching the
# exact checked-out release tag is downloaded (never GitHub "latest").
FRONTEND_DIST_URL=
FRONTEND_DIST_SHA256=
FRONTEND_DIST_SHA256_URL=
NOTELLM_RELEASE_TAG=

# Generate unique values; never commit the resulting .env file.
# SECRET_KEY must be >= 32 characters. Purpose-separated JWT and Fernet keys
# are derived from it with HKDF. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-that-is-at-least-32-chars-long
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-password

# Optional Cloudflare Turnstile protection for login, signup, and password
# recovery. Configure both values or leave both empty for local development.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hard cap for active route/IP and recipient cooldown buckets. New identities
# fail closed at capacity; stale buckets are removed after one hour.
RATE_LIMIT_MAX_ACTIVE_BUCKETS=10000
# Only direct reverse proxies in these networks may supply client IP headers.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12

POSTGRES_SERVER=localhost
# Local compose.override.yml publishes PostgreSQL here. This is deliberately
# separate from POSTGRES_PORT, which remains the container-internal port 5432.
POSTGRES_HOST_PORT=5433
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password

# ---- Email (account verification & password reset) ----
# SMTP_HOST empty = mail backend disabled: signups are auto-marked verified and
# no messages are sent (fine for local dev; production MUST set these).
# Recommended provider: Resend (https://resend.com) — use the SMTP relay values:
#   SMTP_HOST=  smtp.resend.com   SMTP_PORT=587   SMTP_TLS=True
#   SMTP_USER=  resend            SMTP_PASSWORD=<Resend SMTP API key>
#   EMAILS_FROM_EMAIL=<verified sender, e.g. no-reply@notify.au1bhi.com>
# Sender domain must be verified in the provider and have SPF/DKIM/DMARC records
# (see README → 邮件发送与部署). New signups send a 72h verification link.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
# Sender display name on emails (defaults to PROJECT_NAME when empty).
EMAILS_FROM_NAME=NoteLLM
# Registration / email-change are restricted to these mailbox domains (comma-
# separated). Leave unset for the default common-provider list; set to `*` to
# allow any domain.
ALLOWED_EMAIL_DOMAINS=163.com,qq.com,gmail.com,126.com,outlook.com,hotmail.com,foxmail.com,139.com,sina.com,icloud.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587
# How often the dedicated scheduler checks opt-in reminders. Delivery remains
# fixed at 09:00 in each study plan's timezone.
STUDY_REMINDER_POLL_SECONDS=60
# How long a verification link stays valid, in hours.
# EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=72
SENTRY_DSN=

# OpenAI-compatible provider configuration. The app runs without these (you can
# bring your own key in "设置 → 模型配置" after login), but chat/embedding only
# work once either this block is filled in or the user configures their own key.
# Do not place these values in frontend variables.
LLM_BASE_URL=https://provider.example/v1
LLM_API_KEY=replace-with-provider-key
LLM_MODEL=replace-with-chat-model
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=replace-with-embedding-provider-key
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024
# Optional proxy for server-configured chat/embedding providers only. This is
# useful with a local Clash Fake-IP setup; user-supplied BYOK URLs never use it.
# SERVER_PROVIDER_PROXY_URL=http://host.docker.internal:7890
SERVER_PROVIDER_PROXY_URL=

DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
