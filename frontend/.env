# Local frontend defaults — NOTE: release artifacts are built SAME-ORIGIN
# (empty VITE_API_URL) so this tracked file must NOT set VITE_API_URL (a bare
# `bun run build` would otherwise bake a local URL into production SPA builds).
# For LOCAL dev (vite dev server, backend on :8000) create frontend/.env.local
# (git-ignored) with:
#   VITE_API_URL=http://localhost:8000
MAILCATCHER_HOST=http://localhost:1080
